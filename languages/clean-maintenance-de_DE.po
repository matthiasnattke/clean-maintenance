msgid "Active (scheduled)"
msgstr "Aktiv (geplant)"

#: includes/core.php:159
msgid "Period ended"
msgstr "Zeitraum vorbei"

#: includes/core.php:160 includes/network.php:279
msgid "Planned"
msgstr "Geplant"

