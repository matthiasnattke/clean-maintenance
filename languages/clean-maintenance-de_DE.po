#: includes/frontend.php:125
msgid "This website is currently being updated. Please check back soon."
msgstr "Diese Website wird gerade überarbeitet. Bitte schau bald wieder vorbei."

#: includes/frontend.php:230
msgid "Dashboard"
msgstr "Dashboard"

#: includes/frontend.php:286
msgid "Maintenance mode active"
msgstr "Wartungsmodus aktiv"

#: includes/frontend.php:294
msgid "Turn off maintenance mode"
msgstr "Wartungsmodus ausschalten"

#: includes/frontend.php:315 includes/network.php:195
msgid "You are not allowed to do this."
msgstr "Keine Berechtigung."

#: includes/frontend.php:405
msgid "The REST API is only available to logged-in users."
msgstr "Die REST-API ist nur für angemeldete Nutzer verfügbar."

