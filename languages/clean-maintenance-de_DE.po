#: includes/network.php:128
#, php-format
msgid "%d site changed."
msgid_plural "%d sites changed."
msgstr[0] "%d Website geändert."
msgstr[1] "%d Websites geändert."

#. translators: 1: sites in maintenance mode, 2: all sites.
#: includes/network.php:135
#, php-format
msgid "%1$d of %2$d sites are in maintenance mode right now."
msgstr "%1$d von %2$d Websites sind gerade im Wartungsmodus."

#. translators: 1: sites in maintenance mode, 2: all sites.
#: includes/network.php:137
msgid "Each site sets its period, maintenance page, background, exceptions and roles in its own settings."
msgstr "Zeiträume, Wartungsseite, Hintergrund, Ausnahmen und Rollen stellt jede Website in ihren eigenen Einstellungen ein."

#: includes/network.php:144
msgid "Turn selected on"
msgstr "Ausgewählte einschalten"

#: includes/network.php:145
msgid "Turn selected off"
msgstr "Ausgewählte ausschalten"

#: includes/network.php:147
msgid "Apply"
msgstr "Übernehmen"

#: includes/network.php:153
msgid "Site"
msgstr "Website"

#: includes/network.php:154
msgid "State"
msgstr "Zustand"

#: includes/network.php:156
msgid "Actions"
msgstr "Aktionen"

#: includes/network.php:169
msgid "simple notice"
msgstr "einfacher Hinweis"

#: includes/network.php:174 includes/network.php:273
msgid "Turn off"
msgstr "Ausschalten"

#: includes/network.php:176
msgid "Turn on"
msgstr "Einschalten"

#: includes/network.php:186
msgid "“Turn on” applies right away and until you turn it off; a scheduled period is replaced. Network administrators always see the sites normally."
msgstr "„Einschalten“ gilt sofort und bis zum Ausschalten; ein geplanter Zeitraum wird dabei ersetzt. Netzwerk-Administratoren sehen die Websites immer normal."

#: includes/network.php:261
msgid "in maintenance mode"
msgstr "im Wartungsmodus"

#: includes/network.php:262
